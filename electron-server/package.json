{
    "name": "electron-joystick-server",
    "version": "1.0.0",
    "description": "Electron WebSocket Joystick WASD Server MVP",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --win portable"
    },
    "build": {
        "appId": "com.remote.joystick",
        "productName": "RemoteJoystick",
        "files": [
            "**/*"
        ],
        "extraResources": [
            {
                "from": "keyboard.exe",
                "to": "keyboard.exe"
            }
        ],
        "win": {
            "target": "portable"
        }
    },
    "dependencies": {
        "qrcode": "^1.5.4",
        "ws": "^8.16.0"
    },
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^26.8.1"
    }
}